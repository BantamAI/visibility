{
	"name": "@workspace/service",
	"version": "0.7.8",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"check-types": "tsc --noEmit",
		"check:tenant-catalog": "node scripts/check-tenant-catalog.mjs",
		"load:reference-places": "tsx scripts/load-reference-places.ts",
		"load:reference-zctas": "tsx scripts/load-reference-zctas.ts",
		"test": "vitest run --project=unit",
		"test:integration": "vitest run --project=integration",
		"test:pgtap": "bash scripts/run-pgtap.sh"
	},
	"exports": {
		"./local/answer-businesses": "./src/local/answer-businesses/index.ts",
		"./local/delete-brand": "./src/local/delete-brand.ts",
		"./local/grid-scans": "./src/local/grid-scans/index.ts",
		"./local/locations": "./src/local/locations/index.ts",
		"./local/places": "./src/local/places/index.ts",
		"./local/run-planner": "./src/local/run-planner/index.ts",
		"./local/run-planner/constants": "./src/local/run-planner/constants.ts",
		"./local/schema": "./src/local/schema.ts",
		"./local/service-areas": "./src/local/service-areas/index.ts",
		"./local/service-areas/geo": "./src/local/service-areas/geo.ts",
		"./local/tenancy": "./src/local/tenancy.ts",
		"./local/vendor-spend": "./src/local/vendor-spend/index.ts",
		"./local/vendor-spend/limits": "./src/local/vendor-spend/limits.ts",
		"./providers/places": "./src/providers/places/index.ts"
	},
	"dependencies": {
		"@workspace/lib": "workspace:*",
		"drizzle-orm": "catalog:",
		"pg": "catalog:"
	},
	"devDependencies": {
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
