# Copy to .env at the repo root and to apps/web/.env. The developer guide lists the
# variables the app needs to run; these are for the platform integration.

# Local Falcon geo-grid scans (ADR-28)
LOCAL_FALCON_API_KEY=

# Platform service API and webhooks (ADR-31)
PLATFORM_API_URL=
PLATFORM_FACTS_KEY=
PLATFORM_WEBHOOK_SECRET=
